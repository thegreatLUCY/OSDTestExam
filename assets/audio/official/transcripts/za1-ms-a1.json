    "text": "ÖSD-Zertifikat A1 Modellsatz"
  },
  {
    "start": 12.0,
    "end": 15.0,
    "text": "Aufgabe 1"
  },
  {
    "start": 15.0,
    "end": 18.0,
    "text": "Sehen Sie sich die Bilder gut an."
  },
  {
    "start": 18.0,
    "end": 21.0,
    "text": "Sie haben 30 Sekunden Zeit."
  },
  {
    "start": 61.0,
    "end": 66.0,
    "text": "Sie hören jetzt fünf verschiedene Texte zu den Fotos."
  },
  {
    "start": 66.0,
    "end": 69.0,
    "text": "Sie hören jeden Text einmal."
  },
  {
    "start": 69.0,
    "end": 72.0,
    "text": "Welcher Text passt zu welchem Foto?"
  },
  {
    "start": 72.0,
    "end": 76.0,
    "text": "Schreiben Sie die Nummer des Textes unter das Foto."
  },
  {
    "start": 76.0,
    "end": 80.0,
    "text": "Achtung, ein Bild ist zu viel."
  },
  {
    "start": 80.0,
    "end": 86.0,
    "text": "Text 1"
  },
  {
    "start": 86.0,
    "end": 89.0,
    "text": "Text 1"
  },
  {
    "start": 89.0,
    "end": 91.0,
    "text": "Ist das schön hier."
  },
  {
    "start": 91.0,
    "end": 94.0,
    "text": "Die Berge und der blaue Himmel."
  },
  {
    "start": 94.0,
    "end": 97.0,
    "text": "Herrlich. Nur ganz schön weit dieser Weg."
  },
  {
    "start": 97.0,
    "end": 100.0,
    "text": "Wie lange brauchen wir denn noch bis zum Gästehaus?"
  },
  {
    "start": 100.0,
    "end": 103.0,
    "text": "Ich habe schon so einen großen Hunger."
  },
  {
    "start": 103.0,
    "end": 106.0,
    "text": "Ich denke, 20 Minuten werden wir noch brauchen."
  },
  {
    "start": 106.0,
    "end": 110.0,
    "text": "Text 2"
  },
  {
    "start": 110.0,
    "end": 113.0,
    "text": "Wenn Sie hier auf den Computer schauen,"
  },
  {
    "start": 113.0,
    "end": 116.0,
    "text": "Sie sehen hier viele verschiedene Bilder."
  },
  {
    "start": 116.0,
    "end": 119.0,
    "text": "Einige Bilder sollen Sie nehmen und in diese Datei geben."
  },
  {
    "start": 119.0,
    "end": 122.0,
    "text": "Genau das steht auch auf diesem Platz."
  },
  {
    "start": 122.0,
    "end": 125.0,
    "text": "Sehr gut."
  },
  {
    "start": 125.0,
    "end": 128.0,
    "text": "Wie könnte ich die Farben bearbeiten?"
  },
  {
    "start": 128.0,
    "end": 131.0,
    "text": "Text 3"
  },
  {
    "start": 134.0,
    "end": 137.0,
    "text": "Das riecht ja gut."
  },
  {
    "start": 137.0,
    "end": 139.0,
    "text": "Sind die Kartoffeln schon fertig?"
  },
  {
    "start": 139.0,
    "end": 141.0,
    "text": "Ja, die sind schon schön weich."
  },
  {
    "start": 141.0,
    "end": 143.0,
    "text": "Und das Fleisch?"
  },
  {
    "start": 143.0,
    "end": 146.0,
    "text": "Das ist ja schon so."
  },
  {
    "start": 146.0,
    "end": 149.0,
    "text": "Das ist ja schon so."
  },
  {
    "start": 149.0,
    "end": 152.0,
    "text": "Es geht nach 5 Minuten."
  },
  {
    "start": 152.0,
    "end": 155.0,
    "text": "Dann fangen wir schon mal mit der Suppe an."
  },
  {
    "start": 155.0,
    "end": 158.0,
    "text": "Stellst du sie bitte auf den Tisch?"
  },
  {
    "start": 158.0,
    "end": 161.0,
    "text": "Text 4"
  },
  {
    "start": 161.0,
    "end": 164.0,
    "text": "Leider habe ich kein Kleingeld."
  },
  {
    "start": 164.0,
    "end": 167.0,
    "text": "Ich muss mit einem 50 Euro Schein bezahlen."
  },
  {
    "start": 167.0,
    "end": 170.0,
    "text": "Das macht nichts. Ich habe genug Geld zum Wechseln."
  },
  {
    "start": 171.0,
    "end": 174.0,
    "text": "Text 5"
  },
  {
    "start": 174.0,
    "end": 177.0,
    "text": "Und wie oft soll ich dieses Pulver nehmen?"
  },
  {
    "start": 177.0,
    "end": 179.0,
    "text": "Schauen Sie, hier steht"
  },
  {
    "start": 179.0,
    "end": 182.0,
    "text": "3-mal täglich vor dem Essen."
  },
  {
    "start": 182.0,
    "end": 184.0,
    "text": "Es ist auch wichtig,"
  },
  {
    "start": 184.0,
    "end": 187.0,
    "text": "dass Sie dieses Pulver nicht gemeinsam mit den Tabletten nehmen."
  },
  {
    "start": 187.0,
    "end": 190.0,
    "text": "Also vor dem Essen, das Pulver"
  },
  {
    "start": 190.0,
    "end": 193.0,
    "text": "und dazu viel trinken."
  },
  {
    "start": 193.0,
    "end": 196.0,
    "text": "Text 6"
  }
]